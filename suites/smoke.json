      "input": "I can't log in to my account. The password reset link is not working.",
      "assert": [
        {"type": "json_valid"},
        {"type": "json_field_equals", "field": "category", "value": "account"}
      ]
    },
    {
      "id": "c003",
      "input": "The API is returning 500 errors when I try to fetch user data.",
      "assert": [
        {"type": "json_valid"},
        {"type": "json_field_equals", "field": "category", "value": "technical"}
      ]
    },
    {
      "id": "c004",
      "input": "Can you help me with my general question?",
      "assert": [
        {"type": "json_valid"},
        {"type": "json_field_equals", "field": "category", "value": "other"}
      ]
    }
  ]
}
